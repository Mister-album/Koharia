CREATE TABLE library_storage_record (
    connection_id INTEGER NOT NULL,
    account_key TEXT NOT NULL,
    root_id TEXT NOT NULL,
    namespace TEXT NOT NULL,
    record_key TEXT NOT NULL,
    payload TEXT NOT NULL,
    revision INTEGER NOT NULL,
    PRIMARY KEY (connection_id, account_key, root_id, namespace, record_key)
);

getRecord:
SELECT payload FROM library_storage_record
WHERE connection_id = :connectionId AND account_key = :account AND root_id = :root
AND namespace = :namespace AND record_key = :key;

getRecords:
SELECT record_key, payload, revision FROM library_storage_record
WHERE connection_id = :connectionId AND account_key = :account AND root_id = :root AND namespace = :namespace;

putRecord:
INSERT OR REPLACE INTO library_storage_record VALUES (:connectionId, :account, :root, :namespace, :key, :payload, :revision);

removeRecord:
DELETE FROM library_storage_record
WHERE connection_id = :connectionId AND account_key = :account AND root_id = :root
AND namespace = :namespace AND record_key = :key AND revision = :revision;

removeConnection:
DELETE FROM library_storage_record WHERE connection_id = :connectionId;
